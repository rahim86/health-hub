# ============================================================
# Family Health Hub — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# --- Medplum (local Docker) ---
# Create a Client Application in the Medplum admin UI:
#   http://localhost:3000 → Admin → Project → Client Applications → New
# Name it "Family Health Hub Server". Copy the generated ID and secret below.
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_CLIENT_ID=36b89966-b0ee-4a88-8379-ff8fe5f35ae8
MEDPLUM_CLIENT_SECRET=f3cc41ebf9c2d14ffe200564150223367e2ed23d4a7312f20efd4b4e27061d35

# --- EHR Client IDs ---
# Epic:         https://fhir.epic.com → Build Apps → Create App
#               Redirect URI: http://localhost:PORT/callback
# Oracle Health: https://code-console.cerner.com
# MEDITECH:     Contact your hospital's system administrator
EPIC_CLIENT_ID=f5b98cae-b652-48dc-8e85-d94c9f956bd6
ORACLE_CLIENT_ID=4c365d03-b23c-49de-8227-39b4641b6229
MEDITECH_CLIENT_ID=your-meditech-client-id-here

# --- App Settings ---
PORT=4000
REDIRECT_URI=http://localhost:4000/callback
SESSION_SECRET=generate-a-random-string-here
