# ============================================================
# Family Health Hub — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# Dev:  MEDPLUM_BASE_URL / REDIRECT_URI point at localhost (this file).
# Prod: MEDPLUM_BASE_URL / REDIRECT_URI (and every other production value)
#       come from values.yml at the repo root, not this file or GitHub
#       Environment secrets/variables — see .github/workflows/deploy.yml.
#       Production MEDPLUM_BASE_URL is https://api.fhir.uyir.tech/ (the
#       Medplum API — see ../fhir-server), not the app UI domain.

# --- Medplum (local Docker, e.g. docker-compose.full-stack.yml) ---
# Create a Client Application in the Medplum admin UI:
#   http://localhost:3000 → Admin → Project → Client Applications → New
# Name it "Family Health Hub Server". Copy the generated ID and secret below.
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_CLIENT_ID=your-medplum-client-id-here
MEDPLUM_CLIENT_SECRET=your-medplum-client-secret-here

# --- EHR Client IDs ---
# Epic:         https://fhir.epic.com → Build Apps → Create App
#               Redirect URI: http://localhost:PORT/callback
# Oracle Health: https://code-console.cerner.com
# MEDITECH:     Contact your hospital's system administrator
EPIC_CLIENT_ID=your-epic-client-id-here
ORACLE_CLIENT_ID=your-oracle-client-id-here
MEDITECH_CLIENT_ID=your-meditech-client-id-here

# --- App Settings ---
PORT=4000
REDIRECT_URI=http://localhost:4000/callback
DB_PATH=./data/family_health.db
SESSION_SECRET=generate-a-random-string-here
